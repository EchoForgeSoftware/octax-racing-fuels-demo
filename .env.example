# Supabase project for customer accounts and orders (Project Settings -> API).
# Both values are safe to publish: the public key only allows what the row-level
# security policies in supabase/schema.sql permit.
# Use a publishable or legacy anon key, NEVER a secret/service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Local-only customer preview with public sample credentials; leave false for deployment.
# Cannot be combined with Supabase credentials, live service flags or indexing.
NEXT_PUBLIC_CUSTOMER_DEMO=false
# Exact hosted demo allowlist; never a wildcard. Demo remains disabled with a live backend.
NEXT_PUBLIC_DEMO_HOSTS=octa-boost.com,www.octa-boost.com,octa-performance.pages.dev

# Set true ONLY after deploying the payment functions and testing the webhook.
# This is a public feature switch, never an Ozow credential.
NEXT_PUBLIC_OZOW_ENABLED=false
NEXT_PUBLIC_RESELLER_ENABLED=false

# Public CAPTCHA site key. Configure its SECRET separately in Supabase Auth
# and the private payment function secrets; never put a secret here.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Final custom HTTPS domain with no path (leave empty for the local demo).
NEXT_PUBLIC_SITE_ORIGIN=
# Keep the demo prefix locally; use an empty value on the production root domain.
NEXT_PUBLIC_BASE_PATH=/octax-racing-fuels-demo
NEXT_PUBLIC_SITE_INDEXABLE=false

# Public seller disclosures. Obtain these from the business; do not invent them.
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_COMPANY_REGISTRATION=
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_PRIVACY_EMAIL=
NEXT_PUBLIC_PRIVACY_CONTACT=
# Set true only after the business's South African legal adviser has reviewed
# the final policies and the operational commitments they describe.
NEXT_PUBLIC_POLICIES_REVIEWED=false
