# Copy to .env.ozow.local, fill it in privately, and upload with Supabase CLI.
# These values belong ONLY in Supabase function secrets, never NEXT_PUBLIC_*.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are supplied by hosted functions.
OZOW_ENABLED=false
OZOW_ENVIRONMENT=staging
OZOW_SITE_CODE=
OZOW_CLIENT_ID=
OZOW_CLIENT_SECRET=
OZOW_WEBHOOK_SECRET=
# Required for production checkout. Use the secret matching the storefront's
# public Turnstile site key. Supabase Auth needs this configured separately.
TURNSTILE_SECRET_KEY=

# Public HTTPS site root including any GitHub Pages base path, no trailing slash.
CHECKOUT_SITE_URL=https://echoforgesoftware.github.io/octax-racing-fuels-demo
# Origins only (no paths), comma separated. Add a local preview origin if needed.
CHECKOUT_ALLOWED_ORIGINS=https://echoforgesoftware.github.io,http://127.0.0.1:3000,http://localhost:3000
